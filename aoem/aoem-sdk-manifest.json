    "host_integration": "host-integration/embedded_confidential_transfer_host.c",
    "hosted_smoke": "examples/hosted_confidential_transfer_smoke.c",
    "documentation": "docs/confidential-transfer-v1.md",
    "no_public_ffi_abi_change": true,
    "runtime_canon_changed": false,
    "proof_worker_default_changed": false,
