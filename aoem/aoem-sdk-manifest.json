{
  "name": "aoem-fullmax-supervm-host",
  "version": "1.2.0-supervm-fullmax-host",
  "package_stage": "windows-linux-fullmax-host-package",
  "layout": "single_layer_fullmax_package",
  "runtime_baseline": {
    "id": "AOEM FULLMAX Runtime Baseline 2026-06-06",
    "stage": "windows_linux_fullmax_trusted_release",
    "windows_included_and_verified": true,
    "linux_included_and_verified": true,
    "macos_pending_not_bundled": true,
    "document": "RUNTIME-BASELINE.md"
