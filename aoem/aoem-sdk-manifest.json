    "primary_integration_model": "embedded_host_process",
    "secondary_integration_model": "optional_worker_adapter",
    "not_a_standalone_platform_service": true
  },
  "entry": "aoem_execute_ops_wire_v1",
  "output": "aoem_state_read_v1",
  "core_runtime": {
    "windows_library": "windows/core/bin/aoem_ffi.dll",
    "linux_library": "linux/core/bin/libaoem_ffi.so",
    "header_windows": "windows/include/aoem.h",
    "header_linux": "linux/include/aoem.h"
  },
  "proof_engine": {
    "workload": "compute.zk.resident_proof_v1",
    "resident_asset_lifecycle_workload": "compute.zk.resident_asset_lifecycle_v1",
    "proof_contract": "aoem_resident_proof_contract_v1_le_hex",
    "profiles": [
      {
        "profile_id": "merkle_membership_v1",
        "type": "public_inclusion_proof",
        "zero_knowledge_privacy": false,
        "status": "included"
      },
      {
        "profile_id": "zk_merkle_membership_v1",
        "type": "private_membership_proof",
        "hides_leaf": true,
        "hides_sibling_path": true,
        "hides_leaf_index": true,
        "status": "included"
      }
    ],
    "host_integration": {
      "single_proof": "host-integration/embedded_proof_host.c",
      "batch_proof": "host-integration/embedded_batch_proof_host.c",
      "resident_asset_lifecycle": "host-integration/embedded_asset_lifecycle_host.c",
      "hosted_smoke": "examples/hosted_resident_proof_smoke.c",
      "hosted_service": "examples/hosted_resident_proof_service.c",
      "hosted_verifier": "examples/hosted_resident_proof_verify.c"
    },
    "worker_adapter": {
      "source": "worker-adapter/aoem_proof_worker.c",
      "windows_binary": "bin/windows-x86_64/aoem-proof-worker.exe",
      "linux_binary": "bin/linux-x86_64/aoem-proof-worker",
      "examples": {
        "public_merkle_jobs": "worker-adapter/examples/jobs.merkle.jsonl",
        "private_zk_merkle_jobs": "worker-adapter/examples/jobs.zk_merkle.jsonl",
        "mixed_profile_jobs": "worker-adapter/examples/jobs.mixed.jsonl"
      }
    },
    "schemas": {
      "job": "schemas/proof_job.schema.json",
      "result": "schemas/proof_result.schema.json",
      "profiles": "schemas/proof_profiles.json"
    }
  },
  "confidential_transfer": {
    "profile_id": "confidential_transfer_v1",
    "semantic_layer": "sdk_host_profile",
    "underlying_capability": "ringct",
    "product_meaning": "amount_hiding_confidential_transfer_profile",
    "generation_symbol": "aoem_ringct_prove_v1",
