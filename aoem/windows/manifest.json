{
  "stamp": "20260731-060252",
  "release_version": "1.0.0+a951273c",
  "source_commit": "a951273c",
  "platform": "windows",
  "profile": "fullmax",
  "bundle_dir": ".",
  "core_dll": "core/bin/aoem_ffi.dll",
  "public_header": "include/aoem.h",
  "plugins": [
    "aoem_ffi_crypto_hsm.dll",
    "aoem_ffi_crypto_kms.dll",
    "aoem_ffi_crypto_mldsa.dll",
    "aoem_ffi_hsm.dll",
    "aoem_ffi_kms.dll",
    "aoem_ffi_mldsa.dll",
    "aoem_ffi_persist.dll",
    "aoem_ffi_persist_rocksdb.dll",
    "aoem_ffi_runtime_wasm_wasmtime.dll",
    "aoem_ffi_wasm.dll",
    "aoem_ffi_zkvm.dll",
    "aoem_ffi_zkvm_executor.dll",
    "aoem_hsm_plugin.dll",
    "aoem_kms_plugin.dll"
  ],
  "features": "apfl-gpu-production-default,rocksdb-persistence,wasmtime-runtime,privacy-verify,mldsa,zkvm-executor,risc0,sp1,halo2",
  "storage_provider": {
    "entry": "aoem_storage_provider_wire_v1",
