    "bounded_ordered_range_reads": true,
    "json": false
  },
  "semantic_graph_v3": {
    "enabled": true,
    "entry": "aoem_submit_semantic_graph_v3",
    "atomic_writer_bind_entry": "aoem_bind_semantic_atomic_writer_v1",
    "storage_provider_entry": "aoem_storage_provider_wire_v1",
    "domain_agnostic": true,
    "opaque_task_payload": true,
    "host_business_policy_owner": "host",
    "atomic_step_commit": true,
    "durable_completion_boundary": true
  },
  "apfl_gpu_resident_pipeline": {
    "fullmax_apfl_gpu_production_default_included": true,
    "compute_request_name": "compute.apfl.gpu_resident_pipeline_v1",
    "entry": "aoem_execute_ops_wire_v1",
    "result": "aoem_state_read_v1",
    "target_device": "auto",
    "target_device_vendor_id": "any",
    "gpu_capability_gated_production_ready": true,
    "rtx_5090_first_validated_local_device": true,
    "rtx_5090_product_boundary": false,
    "release_artifact_required": true,
    "rc_bundle_install_smoke_required": true,
    "cpu_oracle_compare_required": true,
    "cpu_fallback_required": true
  },
  "ai_sgm_infer": {
    "fullmax_ai_sgm_infer_included": true,
    "compute_request_name": "compute.ai.sgm_infer_v1",
    "entry": "aoem_execute_ops_wire_v1",
    "result": "aoem_state_read_v1",
    "uses_internal_tensor_graph": true,
    "uses_internal_tensor_build": true,
    "uses_internal_graph_runtime": true,
    "uses_apfl_generator_runtime": true,
    "uses_structural_memory_runtime": true,
    "public_aoem_graph_lifecycle_abi": false,
    "public_aoem_tensor_build_abi": false
  },
  "boundaries": {
    "new_standalone_apfl_ffi": false,
    "public_ffi_abi_changed": true,
    "business_semantics": false,
    "novovm_specific_logic": false,
    "new_wire_op": false,
    "new_compute_op": false,
    "cross_device_pass": false,
    "global_production_ready": false,
    "production_performance_claim": false,
    "public_unrestricted_gpu_path": false
  },
  "notes": "Canonical AOEM FULLMAX core plus optional sidecars; host product policy remains outside AOEM."
}
