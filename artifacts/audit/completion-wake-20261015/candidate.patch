+#[test]
+#[ignore = "requires explicit AOEM; product completion wakeup, not TPS"]
+fn real_admission_completion_wakes_parked_consumer_after_reply() -> Result<()> {
+    let mut config = cfg();
+    config.store.library = std::env::var_os("NOVOVM_AOEM_TEST_LIBRARY")
+        .context("explicit trusted AOEM test library required")?
+        .into();
+    config.store.database = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../target/resident-completion-wake-tests")
+        .join(format!(
+            "{}-{}",
+            std::process::id(),
+            SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos()
+        ))
+        .join("state.rocksdb");
+    std::fs::create_dir_all(config.store.database.parent().unwrap())?;
+    let pipeline = CandidatePipeline::start_with_completion_notify(
+        config,
+        OpenMode::CreateNew,
+        Some(thread::current()),
+    )?;
+    // Discard any unrelated startup token. There is no admitted work yet.
+    thread::park_timeout(Duration::ZERO);
+    let mut ticket = admitted(&pipeline);
+    let started = Instant::now();
+    let output = loop {
+        // Deliberately much larger than product idle: without completion
+        // notification this must hit the watchdog, not pass via 1ms polling.
+        thread::park_timeout(Duration::from_secs(5));
+        if let Some(output) = ticket.try_take()? {
+            break output;
+        }
+        ensure!(
+            started.elapsed() < Duration::from_secs(2),
+            "completion did not wake consumer"
+        );
+    };
+    ensure!(
+        started.elapsed() < Duration::from_secs(2),
+        "reply only observed after watchdog"
+    );
+    assert_eq!(output.len(), 2);
+    drop(output);
+    pipeline.shutdown()?;
+    Ok(())
+}
