+
+#[derive(Clone)]
+pub enum ApflIntegerValueBinding {
+    Literal([u32; 32]),
+    Output(usize, usize),
+}
+pub struct ApflIntegerCompositionNode {
+    pub program: usize,
+    pub guard: ApflIntegerValueBinding,
+    pub inputs: Vec<ApflIntegerValueBinding>,
+    pub otherwise: Vec<ApflIntegerValueBinding>,
+}
+pub struct ApflIntegerCompositionPlan {
+    words: Vec<u32>,
+    levels: Vec<(usize, usize)>,
+    exports: usize,
+    arena_words: usize,
+    shapes: Vec<(usize, usize)>,
+}
+impl ApflIntegerCompositionPlan {
+    pub fn new(
+        nodes: Vec<ApflIntegerCompositionNode>,
+        exports: Vec<ApflIntegerValueBinding>,
+        shapes: &[(usize, usize)],
+    ) -> Result<Self, VulkanError> {
+        if !(1..=65_536).contains(&nodes.len())
+            || !(1..=65_536).contains(&exports.len())
+            || !(1..=16).contains(&shapes.len())
+            || shapes
+                .iter()
+                .any(|&(i, o)| i == 0 || o == 0 || i > 16 || o > 16 || i + o > 16)
+        {
+            return Err(invalid("counts"));
+        }
+        let mut offsets = Vec::with_capacity(nodes.len());
+        let mut depths = Vec::with_capacity(nodes.len());
+        let mut levels: Vec<Vec<usize>> = Vec::new();
+        let mut arena_words = 1 + exports.len() * 32;
+        let mut values = 0;
+        for (index, node) in nodes.iter().enumerate() {
+            let &(inputs, outputs) = shapes.get(node.program).ok_or_else(|| invalid("program"))?;
+            if node.inputs.len() != inputs || node.otherwise.len() != outputs {
+                return Err(invalid("signature"));
+            }
+            values += outputs;
+            if values > 131_072 {
+                return Err(invalid("value budget"));
+            }
+            let mut depth = 0;
+            for b in std::iter::once(&node.guard)
+                .chain(&node.inputs)
+                .chain(&node.otherwise)
+            {
+                if let ApflIntegerValueBinding::Output(row, col) = b {
+                    if *row >= index || *col >= shapes[nodes[*row].program].1 {
+                        return Err(invalid("forward or absent reference"));
+                    }
+                    depth = depth.max(depths[*row] + 1);
+                }
+            }
+            offsets.push(arena_words);
+            arena_words += 4 + 32 * outputs;
+            depths.push(depth);
+            if levels.len() <= depth {
+                levels.resize_with(depth + 1, Vec::new);
+            }
+            levels[depth].push(index);
+        }
+        // The first node-count words are a level-sorted indirection table.
+        let mut words = vec![0; nodes.len()];
+        let export_at = words.len();
+        words.resize(export_at + 2 * exports.len(), 0);
+        let mut positions = vec![0; nodes.len()];
+        let encode =
+            |b: &ApflIntegerValueBinding, words: &mut Vec<u32>| -> Result<[u32; 2], VulkanError> {
+                Ok(match b {
+                    ApflIntegerValueBinding::Literal(value) => {
+                        let at = words.len();
+                        words.extend(value);
+                        [0x80000000 | at as u32, 0]
+                    }
+                    ApflIntegerValueBinding::Output(row, col) => {
+                        let node = nodes.get(*row).ok_or_else(|| invalid("export row"))?;
+                        if *col >= shapes[node.program].1 {
+                            return Err(invalid("export column"));
+                        }
+                        [(offsets[*row] + 4 + 32 * col) as u32, offsets[*row] as u32]
+                    }
+                })
+            };
+        for (index, node) in nodes.iter().enumerate() {
+            let at = words.len();
+            positions[index] = at as u32;
+            let size = 4 + 2 * (node.inputs.len() + node.otherwise.len());
+            words.resize(at + size, 0);
+            words[at] = node.program as u32;
+            words[at + 1] = offsets[index] as u32;
+            for (i, b) in std::iter::once(&node.guard)
+                .chain(&node.inputs)
+                .chain(&node.otherwise)
+                .enumerate()
+            {
+                let pair = encode(b, &mut words)?;
+                words[at + 2 + 2 * i..at + 4 + 2 * i].copy_from_slice(&pair);
+            }
+            if words.len() > 8 * 1024 * 1024 {
+                return Err(invalid("plan byte budget"));
+            }
+        }
+        for (i, b) in exports.iter().enumerate() {
+            let pair = encode(b, &mut words)?;
+            words[export_at + 2 * i..export_at + 2 * i + 2].copy_from_slice(&pair);
+        }
+        if words.len() > 8 * 1024 * 1024 {
+            return Err(invalid("plan byte budget"));
+        }
+        let mut at = 0;
+        let levels = levels
+            .into_iter()
+            .map(|mut level| {
+                // Keep neighboring invocations on the same small program.
+                level.sort_by_key(|&n| nodes[n].program);
+                let start = at;
+                for node in level {
+                    words[at] = positions[node];
+                    at += 1;
+                }
+                (start, at - start)
+            })
+            .collect();
+        Ok(Self {
+            words,
+            levels,
+            exports: exports.len(),
+            arena_words,
+            shapes: shapes.to_vec(),
+        })
+    }
+    pub fn capacities(&self) -> (usize, usize) {
+        (
+            self.words.len().next_power_of_two().max(2),
+            self.arena_words.next_power_of_two(),
+        )
+    }
+}
+
+pub struct ApflResidentIntegerComposition {
+    dispatch: ResidentIntegerDispatch,
+    shapes: Vec<(usize, usize)>,
+    input_words: usize,
+    result_words: usize,
+}
+impl ApflResidentIntegerComposition {
+    pub fn fits(&self, plan: &ApflIntegerCompositionPlan) -> bool {
+        self.shapes == plan.shapes
+            && self.input_words >= plan.words.len()
+            && self.result_words >= plan.arena_words
+    }
+    pub fn run(
+        &mut self,
+        plan: &ApflIntegerCompositionPlan,
+    ) -> Result<Vec<[u32; 32]>, VulkanError> {
+        if !self.fits(plan) {
+            return Err(invalid("resource shape"));
+        }
+        let words = self.dispatch.exchange_composition(
+            &plan.words,
+            &plan.levels,
+            plan.exports,
+            1 + plan.exports * 32,
+        )?;
+        if words[0] != 0 {
+            return Err(invalid("guard, predecessor or active program rejected"));
+        }
+        Ok(words[1..]
+            .chunks_exact(32)
+            .map(|v| v.try_into().unwrap())
+            .collect())
+    }
+}
+
+impl ApflResidentModelDevice {
+    pub fn create_integer_composition(
+        &self,
+        shader: &[u8],
+        programs: &[ApflIntegerOutcomeProgram],
+        input_words: usize,
+        result_words: usize,
+    ) -> Result<ApflResidentIntegerComposition, VulkanError> {
+        if !(1..=16).contains(&programs.len())
+            || input_words < 2
+            || input_words % 2 != 0
+            || input_words > 8 * 1024 * 1024
+            || result_words == 0
+            || result_words > 8 * 1024 * 1024
+            || programs.iter().any(|p| p.numeric_bits() != 1024)
+        {
+            return Err(invalid("resource bounds"));
+        }
+        let mut words = vec![0; 32]; // 16 update words followed by sixteen program offsets
+        for (i, p) in programs.iter().enumerate() {
+            words[16 + i] = words.len() as u32;
+            words.extend_from_slice(p.device_words());
+        }
+        let shapes = programs
+            .iter()
+            .map(|p| (p.input_count(), p.output_count()))
+            .collect();
+        Ok(ApflResidentIntegerComposition {
+            dispatch: ResidentIntegerDispatch::new(
+                self,
+                shader,
+                words,
+                1,
+                input_words / 2,
+                result_words,
+            )?,
+            shapes,
+            input_words,
+            result_words,
+        })
+    }
+}

diff --git a/crates/backend/aoem-backend-gpu/shaders/apfl_integer_composition.comp b/crates/backend/aoem-backend-gpu/shaders/apfl_integer_composition.comp
new file mode 100644
index 00000000..22cc1448
--- /dev/null
+++ b/crates/backend/aoem-backend-gpu/shaders/apfl_integer_composition.comp
@@ -0,0 +1,52 @@
+#version 450
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+#extension GL_GOOGLE_include_directive : require
+layout(local_size_x=32) in;
+layout(set=0,binding=0,std430) readonly buffer Program {uint p[];};
+layout(set=0,binding=1,std430) readonly buffer Inputs {uint x[];};
+layout(set=0,binding=2,std430) buffer Results {uint y[];};
+#include "apfl_checked_multilimb_integer_ops.glsl"
+
+// Validated references address either immutable literals or an earlier level's
+// successful output. Every level is separated by the existing compute barrier.
+MultiInteger bound_value(uint at,inout bool valid){
+    uint address=x[at],producer=x[at+1u];
+    MultiInteger value;
+    if((address&0x80000000u)!=0u){
+        for(uint j=0u;j<ML;++j)value.v[j]=x[(address&0x7fffffffu)+j];
+    }else{
+        if(y[producer]!=0u)valid=false;
+        for(uint j=0u;j<ML;++j)value.v[j]=y[address+j];
+    }
+    return value;
+}
+void main(){
+    uint row=gl_GlobalInvocationID.x;if(row>=p[0])return;
+    bool valid=true;
+    if(p[2]==1u){
+        MultiInteger value=bound_value(p[1]+2u*row,valid);
+        if(!valid)atomicOr(y[0],1u);
+        for(uint j=0u;j<ML;++j)y[1u+ML*row+j]=value.v[j];
+        return;
+    }
+    uint at=x[p[1]+row],origin=p[16u+x[at]],base=x[at+1u];
+    uint width=p[origin+1u],outputs=p[origin+2u];
+    MultiInteger guard=bound_value(at+2u,valid),args[16],answer[16];
+    uvec4 status=uvec4(0u,0u,0xffffffffu,0xffffffffu);
+    bool enabled=weq(guard,scalar(1u)),disabled=weq(guard,scalar(0u));
+    if(!valid||(!enabled&&!disabled)){
+        status.x=3u;
+    }else if(disabled){
+        // Do not evaluate the skipped program's inputs or arithmetic domain.
+        for(uint i=0u;i<outputs;++i)answer[i]=bound_value(at+4u+2u*width+2u*i,valid);
+        if(!valid)status.x=3u;
+    }else{
+        for(uint i=0u;i<width;++i)args[i]=bound_value(at+4u+2u*i,valid);
+        if(valid){
+            #include "apfl_integer_outcome_eval.glsl"
+        }else status.x=3u;
+    }
+    if(status.x!=0u||status.y!=0u||status.z!=0xffffffffu||status.w!=0xffffffffu)atomicOr(y[0],1u);
+    for(uint j=0u;j<4u;++j)y[base+j]=status[j];
+    for(uint i=0u;i<outputs;++i)for(uint j=0u;j<ML;++j)y[base+4u+ML*i+j]=status.x==0u?answer[i].v[j]:0u;
+}

diff --git a/crates/backend/aoem-backend-gpu/shaders/apfl_integer_outcome_eval.glsl b/crates/backend/aoem-backend-gpu/shaders/apfl_integer_outcome_eval.glsl
new file mode 100644
index 00000000..e5c4c0fc
--- /dev/null
+++ b/crates/backend/aoem-backend-gpu/shaders/apfl_integer_outcome_eval.glsl
@@ -0,0 +1,41 @@
+// Shared checked-i1024 outcome evaluator. Both row and composition adapters
+// use the same arithmetic, domain/refutation ordering and postconditions.
+// Lexical include: do not pass large private arrays through GLSL function
+// parameters (some drivers cannot compile that expanded call frame).
+{
+    uint nd=p[origin+3u],np=p[origin+4u],nc=p[origin+5u],body=nd+np;
+    uint tag=0u,component=0xffffffffu,fault=0u,instruction=0xffffffffu;
+    MultiInteger values[80],registers[80];
+    // Invocation-scoped interpreter, preserving v1 component and fault ordering.
+    for(uint g=0u;g<body+1u+nc;++g){
+        uint offset=origin+p[origin+8u+g],failed=0xffffffffu;
+        for(uint i=0u;i<p[offset+1u];++i)values[i]=args[i];
+        wide_fault=0u;
+        for(uint k=0u;k<p[offset+3u];++k){
+            uint c=offset+p[offset+p[offset+4u]+k],f=offset+p[c];
+            uint n=p[f+1u],constants=p[f+2u],steps=p[f+3u];
+            uint ca=f+8u+n,sa=ca+4u*constants;
+            for(uint i=0u;i<n;++i)registers[i]=values[p[c+4u+p[f+8u+i]]];
+            for(uint i=0u;i<constants;++i){
+                uint at=ca+4u*i,sign=(p[at+3u]&0x80000000u)!=0u?0xffffffffu:0u;
+                for(uint j=0u;j<ML;++j)registers[n+i].v[j]=j<4u?p[at+j]:sign;
+            }
+            for(uint i=0u;i<steps;++i){
+                uint at=sa+4u*i;
+                registers[n+constants+i]=wcompute(p[at],registers[p[at+1u]],registers[p[at+2u]]);
+                if(wide_fault!=0u){failed=p[c+2u]+i;break;}
+            }
+            if(wide_fault!=0u)break;
+            for(uint i=0u;i<p[f+4u];++i)values[p[c+1u]+i]=registers[p[sa+4u*steps+i]];
+        }
+        if(g>=nd&&g<body){
+            if(wide_fault==0u&&weq(values[p[offset+p[offset+5u]]],scalar(1u))){tag=2u;component=g;break;}
+            continue;
+        }
+        if(wide_fault!=0u){tag=3u;component=g;fault=wide_fault;instruction=failed;break;}
+        if(g==body){
+            for(uint i=0u;i<outputs;++i){answer[i]=values[p[offset+p[offset+5u]+i]];args[width+i]=answer[i];}
+        }else if(!weq(values[p[offset+p[offset+5u]]],scalar(1u))){tag=g<nd?1u:3u;component=g;break;}
+    }
+    status=uvec4(tag,fault,component,instruction);
+}
