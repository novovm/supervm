+#[test]
+#[ignore = "requires Vulkan; bounded sixteen-program composition table"]
+fn composition_sixteen_resources_preserve_dependencies() {
+    fn lit(bytes: &mut Vec<u8>, n: u32) {
+        words(bytes, [0, n].into_iter().chain([0; 31]));
+    }
+    let resources = IntegerResources::default();
+    let ids: Vec<_> = (0..MAX_PROGRAMS)
+        .map(|_| open(&resources, 5, 1, 0))
+        .collect();
+    let mut body = Vec::new();
+    words(&mut body, [MAX_PROGRAMS as u32, 1]);
+    for id in &ids {
+        body.extend(id.to_le_bytes());
+    }
+    for index in 0..MAX_PROGRAMS as u32 {
+        words(&mut body, [index]);
+        lit(&mut body, 1);
+        if index == 0 {
+            lit(&mut body, 7);
+        } else {
+            words(&mut body, [1, index - 1, 0]);
+        }
+        lit(&mut body, 1);
+        lit(&mut body, 0);
+    }
+    words(&mut body, [1, MAX_PROGRAMS as u32 - 1, 0]);
+    let mut payload = request(2, ids[0], 5, MAX_PROGRAMS as u32, &body);
+    payload[8..12].copy_from_slice(&10u32.to_le_bytes());
+    payload.splice(40..40, 1u64.to_le_bytes());
+    resources.execute_binary(&payload).unwrap();
+    let result = resources.take_binary(ids[0], 1).unwrap();
+    assert_eq!(u32::from_le_bytes(result[32..36].try_into().unwrap()), 23);
+    assert!(result[36..].iter().all(|b| *b == 0));
+    let mut oversized = payload;
+    oversized[40..48].copy_from_slice(&2u64.to_le_bytes());
+    oversized[48..52].copy_from_slice(&17u32.to_le_bytes());
+    assert!(resources.execute_binary(&oversized).is_err());
+    assert!(resources.take_binary(ids[0], 2).is_err());
+}
