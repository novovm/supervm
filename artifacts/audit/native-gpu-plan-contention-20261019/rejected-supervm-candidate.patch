+#[test]
+#[ignore = "trusted AOEM and Vulkan; direct checked operators versus historical eager selector"]
+fn resident_direct_scalar_assets_match_eager_oracle() -> Result<()> {
+    use novovm_exec::resident::{AoemExecOpenOptions, AoemLibrarySelection};
+    let library = std::path::PathBuf::from(
+        std::env::var_os("NOVOVM_AOEM_TEST_LIBRARY").context("AOEM library required")?,
+    );
+    let facade =
+        AoemLibrarySelection::new(&library, AoemExecOpenOptions::default())?.open_wire_facade()?;
+    let mut session = facade.create_integer_resource_session_v7("novovm/scalar-oracle")?;
+    let negative = |mut n: AoemInteger1024V1| {
+        let mut carry = 1u64;
+        for limb in &mut n.0 {
+            let next = u64::from(!*limb) + carry;
+            *limb = next as u32;
+            carry = next >> 32;
+        }
+        n
+    };
+    let mut above_u128 = AoemInteger1024V1::from_u128(0);
+    above_u128.0[8] = 1; // 2^256 scratch; products still fit checked i1024.
+    let edges = [
+        AoemInteger1024V1::from_u128(0),
+        AoemInteger1024V1::from_u128(1),
+        AoemInteger1024V1::from_u128(u64::MAX as u128),
+        AoemInteger1024V1::from_u128(u128::MAX),
+        negative(AoemInteger1024V1::from_u128(1)),
+        negative(AoemInteger1024V1::from_u128(u128::MAX)),
+        above_u128,
+        negative(above_u128),
+    ];
+    let assets = super::super::effect_assets::assets();
+    let oracle = session.open(&super::super::effect_assets::scalar_oracle(), 4, 1, 128)?;
+    for mode in 0..7 {
+        let program = super::super::effect_assets::scalar_program(mode);
+        let inputs = if mode == 5 { 3 } else { 2 };
+        let resource = session.open(&assets[program - 1], inputs, 1, 128)?;
+        let mut old_rows = Vec::new();
+        let mut new_rows = Vec::new();
+        for a in edges {
+            for b in edges {
+                for flag in 0..2 {
+                    let flag = AoemInteger1024V1::from_u128(flag);
+                    old_rows.push(vec![a, b, flag, AoemInteger1024V1::from_u128(mode)]);
+                    new_rows.push(if mode == 5 {
+                        vec![a, b, flag]
+                    } else {
+                        vec![a, b]
+                    });
+                }
+            }
+        }
+        let old = session.run_binary_v1(&oracle, &old_rows)?;
+        let new = session.run_binary_v1(&resource, &new_rows)?;
+        assert_eq!(old.rows.len(), new.rows.len());
+        for (before, after) in old.rows.iter().zip(&new.rows) {
+            assert_eq!(before.outcome, after.outcome, "mode={mode}");
+            assert_eq!(before.fault, after.fault, "mode={mode}");
+            assert_eq!(before.values, after.values, "mode={mode}");
+        }
+        session.close(&resource)?;
+    }
+    session.close(&oracle)?;
+    Ok(())
+}
