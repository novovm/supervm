+#[test]
+fn asset_capture_hashes_are_reserved_without_losing_two_full_body_slots() -> Result<()> {
+    let mut cfg = config("unused".into());
+    cfg.capture = crate::native_pipeline::service::ASSET_CAPTURE_BUDGET;
+    cfg.max_batches = 2;
+    cfg.max_retained_bytes = 256 * 1024 * 1024;
+    let body_bytes = 8 * 1024 * 1024;
+    let reserved = BatchRequest::retained_reservation(body_bytes, &cfg)?;
+    let hashes = cfg.capture.nodes * std::mem::size_of::<NodeHash>();
+    assert_eq!(
+        reserved,
+        body_bytes * 3
+            + cfg.capture.bytes
+            + hashes
+            + cfg.capture.keys * 256
+            + cfg.store.packet_budget.max_bytes * 2
+            + 4096
+    );
+    assert!(reserved * cfg.max_batches <= cfg.max_retained_bytes);
+    cfg.capture.nodes = usize::MAX;
+    assert!(BatchRequest::retained_reservation(body_bytes, &cfg).is_err());
+    Ok(())
+}
