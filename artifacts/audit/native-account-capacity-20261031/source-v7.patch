+fn asset_hash_ordered_read_turns_reduce_frontier_loads_and_preserve_1024_rows() -> Result<()> {
+    let mut records = BTreeMap::new();
+    let mut inputs = Vec::new();
+    for index in (0..1024u32).rev() {
