+/// Reassembly can finish two prepared inputs in reverse order. Prefer the
+/// earlier one already present in this SAME bounded source queue; never wait
+/// for a missing sequence (queries also consume sequence numbers). This is a
+/// preparation hint, not nonce ordering or permission to skip admission.
+fn pop_transaction_source(queue: &mut VecDeque<TransactionSource>) -> Option<TransactionSource> {
+    let earlier_second = match (queue.front(), queue.get(1)) {
+        (
+            Some(TransactionSource::Raw {
+                message: first,
+                origin: first_origin,
+            }),
+            Some(TransactionSource::Raw {
+                message: second,
+                origin: second_origin,
+            }),
+        ) if first_origin == second_origin => match (first.as_ref(), second.as_ref()) {
+            (Message::Transactions { scope: a, .. }, Message::Transactions { scope: b, .. })
+            | (
+                Message::ApflTransactions { scope: a, .. },
+                Message::ApflTransactions { scope: b, .. },
+            )
+            | (
+                Message::AssetTransactions { scope: a, .. },
+                Message::AssetTransactions { scope: b, .. },
+            ) => {
+                b.sequence < a.sequence
+                    && TransactionsScope {
+                        sequence: a.sequence,
+                        ..*b
+                    } == *a
+            }
+            _ => false,
+        },
+        _ => false,
+    };
+    if earlier_second {
+        queue.remove(1)
+    } else {
+        queue.pop_front()
+    }
+}
