+pub(crate) fn asset_ids(ids: &[[u8; 32]]) -> String {
+    use sha2::{Digest, Sha256};
+    let mut digest = Sha256::new();
+    for id in ids {
+        digest.update(id);
+    }
+    hash(Some(digest.finalize().into()))
+        .as_str()
+        .unwrap()
+        .to_owned()
+}
