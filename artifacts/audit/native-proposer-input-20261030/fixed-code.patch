+        rx.drain_queue_limit = 8;
+        let sender = UdpSocket::bind("127.0.0.1:0").unwrap();
+        let address = rx.local_addr().unwrap();
+        for value in [0_u8, 1] {
+            sender.send_to(&[value], address).unwrap();
+        }
+        assert_eq!(rx.receive_packet_v1().unwrap().unwrap().0, vec![0]);
+        assert_eq!(rx.drain_queue.lock().unwrap().len(), 1);
+        for value in [2_u8, 3] {
+            sender.send_to(&[value], address).unwrap();
+        }
+        assert_eq!(rx.receive_packet_v1().unwrap().unwrap().0, vec![1]);
+        assert_eq!(
+            rx.drain_queue.lock().unwrap().len(),
+            0,
+            "consume retained FIFO work before refilling from the socket"
+        );
+        assert_eq!(rx.receive_packet_v1().unwrap().unwrap().0, vec![2]);
