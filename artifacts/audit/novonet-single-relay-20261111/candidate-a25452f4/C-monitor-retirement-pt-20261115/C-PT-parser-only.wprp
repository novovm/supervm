<!-- Parser-only candidate. This task does not start a recording. -->
<WindowsPerformanceRecorder Version="1.0" Author="validator-C">
  <Profiles>
    <SystemCollector Id="CPTSystemCollector" Name="C PT feasibility">
      <BufferSize Value="64" />
      <Buffers Value="64" />
    </SystemCollector>
    <SystemProvider Id="CPTSystemProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="SampledProfile" />
      </Keywords>
    </SystemProvider>
    <HardwareCounter Id="CPTHardwareCounter" Strict="true">
      <ProcessorTrace>
        <BufferSize Value="4" />
