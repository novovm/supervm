    <Profile Id="C_PT_Parser.Light.Memory" Name="C_PT_Parser" Description="Parser-only Intel PT feasibility; not qualified for capture" LoggingMode="Memory" DetailLevel="Light">
      <Collectors>
        <SystemCollectorId Value="CPTSystemCollector">
          <SystemProviderId Value="CPTSystemProvider" />
          <HardwareCounterId Value="CPTHardwareCounter" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
